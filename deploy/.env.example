# Copy to .env and fill in before running setup.sh. Never commit .env.

# Wazuh stack version (matches the official wazuh-docker release tag).
WAZUH_VERSION=v4.9.2

# Where the stack is cloned/installed on the VM.
STACK_DIR=/opt/soc-lab

# API keys are NOT set here - they are entered in the Shuffle vault after setup:
#   VirusTotal API key   -> VIRUSTOTAL_API_KEY
#   TheHive API key      -> THEHIVE_API_KEY
#   Wazuh API user/pass  -> created in the Wazuh dashboard
