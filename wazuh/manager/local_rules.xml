<!--
  Custom Wazuh detection rules for the SOC Automation Home Lab.
  File location on the manager: /var/ossec/etc/rules/local_rules.xml

  These rules sit on top of the Sysmon decoders that ship with Wazuh and raise
  high-severity alerts for credential-dumping activity. Rule 100002 is the one
  that drives the whole automation workflow (steps 3-8 in the architecture diagram).
-->

<group name="sysmon,windows,credential_access,">

  <!--
    Mimikatz detection via Sysmon Event ID 1 (Process Creation).
    We match on OriginalFileName, which is read from the PE header, so the
    detection still fires when the attacker renames mimikatz.exe to something
    innocent-looking like svchost.exe or update.exe.
  -->
  <rule id="100002" level="15">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)mimikatz\.exe</field>
    <description>Mimikatz credential-dumping tool executed: $(win.eventdata.image)</description>
    <mitre>
      <id>T1003.001</id> <!-- OS Credential Dumping: LSASS Memory -->
    </mitre>
  </rule>

  <!--
    Backstop rule: catch Mimikatz by its well-known command-line keywords
    (sekurlsa::logonpasswords, lsadump::sam, ...) in case OriginalFileName was stripped.
  -->
  <rule id="100003" level="15">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(sekurlsa|lsadump|kerberos::|crypto::|privilege::debug|logonpasswords)</field>
    <description>Mimikatz command-line pattern detected: $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>

  <!--
    Suspicious access to LSASS memory (Sysmon Event ID 10 - ProcessAccess).

    Wazuh's built-in rule 92900 already catches the most common read mask (0x1010)
    and is evaluated before this file, so a custom rule for the same mask never
    fires. The detection tests in tests/detections showed this. So the work is split:
      100004 - the masks 92900 does not cover (full access and other dumper variants)
      100005 - sits on top of 92900, so the 0x1010 case also shows up under our rule IDs
  -->
  <rule id="100004" level="12">
    <if_group>sysmon_event_10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^(0x1410|0x1438|0x143a|0x1fffff)$</field>
    <description>Suspicious LSASS memory access from $(win.eventdata.sourceImage) (possible credential dumping)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>

  <rule id="100005" level="12">
    <if_sid>92900</if_sid>
    <description>LSASS memory read by $(win.eventdata.sourceImage) (possible credential dumping)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>

</group>
